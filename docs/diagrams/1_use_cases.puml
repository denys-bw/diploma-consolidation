@startuml
!include style.iuml
left to right direction
actor "Користувач" as U
actor "Дослідник" as R
rectangle "Веб-застосунок" {
  usecase "Створити проєкт" as UC1
  usecase "Завантажити джерела" as UC2
  usecase "Переглянути профіль джерела" as UC3
  usecase "Перевірити зіставлення колонок" as UC4
  usecase "Налаштувати обробку" as UC5
  usecase "Запустити обробку" as UC6
  usecase "Переглянути звіт" as UC7
  usecase "Перевірити сумнівні пари" as UC8
  usecase "Вивантажити результат" as UC9
}
rectangle "Експериментальний модуль" {
  usecase "Перевірити набори даних" as UC10
  usecase "Виконати експерименти" as UC11
  usecase "Побудувати графіки" as UC12
}
U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
UC2 ..> UC3 : <<extend>>
UC6 ..> UC4 : <<include>>
UC8 ..> UC7 : <<extend>>
R --> UC10
R --> UC11
R --> UC12
UC11 ..> UC10 : <<include>>
@enduml
