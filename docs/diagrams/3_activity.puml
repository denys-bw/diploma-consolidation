@startuml
!include style.iuml
start
:Прочитати файли джерел;
:Визначити типи колонок, пропуски й викиди;
:Зіставити колонки джерел;
if (Зіставлення потребує змін?) then (так)
  :Відредагувати атрибути;
else (ні)
endif
:Уніфікувати формати значень;
repeat
  :Відібрати пари-кандидати;
  :Обчислити вектори подібності;
  :Оцінити модель Фелегі–Зунтера методом EM;
  if (Є повтори всередині джерел?) then (так)
    :Оцінювати пари всередині джерел і між ними;
    :Групувати записи середнім зв'язком;
  else (ні)
    :Оцінювати лише пари між джерелами;
    :Розподілити пари «один до одного»;
  endif
  :Уточнити оцінку логістичною регресією;
  if (Є відповіді користувача?) then (так)
    :Скоригувати модель за відповідями;
  else (ні)
  endif
  :Об'єднати записи кожної групи;
  :Відновити пропуски;
  :Оцінити якість до і після обробки;
  :Сформувати звіт;
backward :Відповісти на сумнівні пари;
repeat while (Потрібна ручна перевірка пар?) is (так)
->ні;
stop
@enduml
