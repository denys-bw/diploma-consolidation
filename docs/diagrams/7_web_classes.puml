@startuml
!include style.iuml
left to right direction
package views {
  class "projects" as vp <<module>> {
    +index()
    +create()
    +show(project_id)
    +delete(project_id)
  }
  class "sources" as vs <<module>> {
    +upload(project_id)
    +delete_file(project_id, file_id)
    +toggle(project_id, source_id)
    +show(project_id, source_id)
    +configure(project_id, source_id)
    +configure_all(project_id)
  }
  class "mapping" as vm <<module>> {
    +edit(project_id)
    +update(project_id)
  }
  class "runs" as vr <<module>> {
    +settings(project_id)
    +save_settings(project_id)
    +show(run_id)
    +status(run_id)
    +entity(run_id, entity)
    +download(run_id, kind)
    +delete(run_id)
  }
  class "reviews" as vv <<module>> {
    +show(run_id)
    +save(run_id)
  }
}
package services {
  class Services
  class ProjectService
  class SourceService
  class MappingService
  class RunService {
    +validate(project_id, options): str[]
    +start(project_id, options): int
    +remove(run_id)
  }
  class ReviewService
  class ReportReader
  class ReportWriter
  class ConsolidationJob
  class RunProgress {
    +stage_started(stage)
  }
}
package repositories {
  class Repositories
  class ProjectRepository
  class SourceRepository
  class AttributeRepository
  class RunRepository
  class ReviewRepository
}
class RunQueue {
  +submit(job): Future
  +join(timeout): bool
}
class Storage
vp ..> Services
vs ..> Services
vm ..> Services
vr ..> Services
vv ..> Services
Services *-- ProjectService
Services *-- SourceService
Services *-- MappingService
Services *-- RunService
Services *-- ReviewService
RunService ..> RunQueue
RunQueue ..> ConsolidationJob
ConsolidationJob ..> RunProgress
ConsolidationJob ..> ReportWriter
ReviewService ..> ReportReader
ProjectService ..> Repositories
SourceService ..> Storage
RunService ..> Repositories
Repositories *-- ProjectRepository
Repositories *-- SourceRepository
Repositories *-- AttributeRepository
Repositories *-- RunRepository
Repositories *-- ReviewRepository
@enduml
